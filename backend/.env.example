# Environment variables for UstadExam's backend.
#
# Copy this file to backend/.env and fill in real values for local development.
# In production (Railway), set these directly as service Variables — backend/.env is
# gitignored and never deployed; nothing here is a real secret.
#
# Every variable below was found by grepping backend/ for os.getenv()/os.environ.get() calls —
# re-verify with the same grep if this file ever looks stale:
#   grep -rn "os\.getenv(\|os\.environ\.get(\|os\.environ\[" backend/

# --- Core app ---

# development | production. Tags Sentry events by environment and gates the /sentry-debug
# test route (only reachable when NOT "production"). Defaults to "development" if unset.
ENVIRONMENT=development

# Comma-separated list of origins allowed to make cross-origin requests to the API. Only
# matters when frontend and backend are on different origins (e.g. local dev: frontend on
# :5500, backend on :8000). Same-origin production traffic (ustadexam.com) isn't affected by
# this either way. Defaults to the local-dev pair below if unset.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Database ---

# Postgres connection string. If unset, falls back to a local SQLite file at
# backend/data/exam_generator.db (no Postgres install needed for local dev). Railway hands
# this out automatically when a Postgres service is linked — a postgres:// scheme is
# auto-rewritten to postgresql:// for SQLAlchemy 1.4+/psycopg2 compatibility.
DATABASE_URL=postgresql://user:password@host:port/dbname

# --- Auth ---

# Signing secret for session JWTs (see services/auth_service.py). MUST be set to a long,
# random value in production — the code falls back to an insecure hardcoded dev value if
# unset, and every restart with no value set invalidates all existing sessions.
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Google OAuth 2.0 Web Client ID/Secret (classic Authorization Code redirect flow — see
# frontend/src/core/auth.js and routers/auth.py). Both required for "Continue with Google" to
# work; without them it 501s. Get these from Google Cloud Console > APIs & Services >
# Credentials. The Client ID here must match the GOOGLE_CLIENT_ID constant hardcoded in
# frontend/src/core/auth.js (client IDs aren't secret; the Secret below is).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# --- Analytics (GA4 Measurement Protocol) ---

# Same "G-XXXXXXXXXX" property ID as the gtag.js snippet in frontend/index.html. Powers the
# server-side exam_generated/grading_completed events (services/analytics_service.py); both
# this and the API secret below must be set or those events silently no-op.
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Created separately in GA4 Admin > Data Streams > (your stream) > Measurement Protocol API
# secrets. Never exposed to the frontend — that's the whole reason these events fire
# server-side instead of via gtag().
GA4_API_SECRET=your-ga4-api-secret

# --- AI / vector search ---

# Google Gemini API key (services/llm_service.py) — required for real exam generation/grading.
# Get one at https://aistudio.google.com/apikey.
GEMINI_API_KEY=your-gemini-api-key

# "true" to skip real Gemini calls and return canned mock exam data instead (useful for
# frontend/local dev without burning API quota). Any other value (or unset) means real calls.
MOCK_MODE=false

# Directory ChromaDB persists its vector index to (services/vector_store.py). On Railway this
# MUST point at a mounted Volume, or the index is wiped on every redeploy. Falls back to
# backend/data/chroma_db for local dev if unset.
CHROMA_PERSIST_DIR=/data/chroma_db

# Optional. Not read by our own code (grep confirms zero os.getenv("HF_TOKEN") calls) — the
# huggingface_hub library reads it directly when downloading the sentence-transformers
# embedding model used by the vector store. Without it, downloads are rate-limited and slower
# (you'll see "sending unauthenticated requests to the HF Hub" in the logs); the app still
# works fine either way. Get a token at https://huggingface.co/settings/tokens.
HF_TOKEN=
